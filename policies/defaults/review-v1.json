{
  "schema_version": 1,
  "policy_version": "review-v1",
  "interval_days": [1, 3, 7, 14],
  "terminal_interval_days": 14,
  "review_percent": 25,
  "lapse": "next_study_day_retain_stage",
  "same_session_lapse": "short_follow_up_takes_precedence",
  "max_advances_per_objective_session": 1,
  "queue_order": ["original_due_date", "objective_id"],
  "oversized": "defer_offer_split_or_budget_change",
  "fill_with_smaller_due_items": true,
  "budget_unit": "integer_seconds",
  "allowance_rounding": "floor"
}
